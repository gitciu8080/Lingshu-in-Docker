LINGSHU_QDRANT_URL=http://127.0.0.1:6333


LINGSHU_EMBEDDING_API_KEY=sk-your-embedding-key
LINGSHU_EMBEDDING_BASE_URL=http/https://URL/v1
LINGSHU_EMBEDDING_MODEL=nomic-embed-text:latest
LINGSHU_EMBEDDING_DIMENSIONS=256
# 部分兼容端点不接受 dimensions 参数时设为 0；此时 DIMENSIONS 必须填写模型原生输出维度。
# 灵枢启动时还会探测真实维度，并在模型变化时自动重建派生的 Qdrant collection。
LINGSHU_EMBEDDING_PASS_DIMENSIONS=1
# Ollama 作为 Embedding 服务时，使用 OpenAI 兼容地址（例如 http://host:11434/v1）。


# ── PDF 报告字体（可选）──
# 指向已合法安装的微软雅黑 TTF；标题使用粗体，正文使用常规体。
# 未设置或字体不存在时，系统回退到内置中文字体以保证 PDF 仍可生成。
LINGSHU_PDF_FONT_REGULAR=frontend/MSYH.TTC
LINGSHU_PDF_FONT_BOLD=frontend/MSYHBD.TTC


# ── 超级管理员（/superadmin）──
# 首次启动时使用此专用账号创建超级管理员。务必替换为高强度、仅管理员持有的密码。
# 留空时不创建超级管理员，/superadmin 将无法登录。
LINGSHU_SUPERADMIN_USERNAME=superadmin
LINGSHU_SUPERADMIN_PASSWORD=gdcp@2026

# 留空时关闭公开注册；如需开放注册，设置高强度随机邀请码。
LINGSHU_REGISTRATION_INVITE_CODE=type-key

# ── PostgreSQL（容器化生产模式）──
# 先在 Docker/ 目录执行 docker compose up -d postgres；密码不要提交到仓库。
LINGSHU_POSTGRES_PASSWORD=123456
# 服务运行在宿主机时使用 127.0.0.1；未来 API 也进入 compose 时改为 postgres。
LINGSHU_DATABASE_URL=postgresql://lingshu:replace-with-a-long-random-password@127.0.0.1:5432/lingshu

# ── Docker 工作区 ──
# 每个会话使用独立容器（kali-full 镜像，所有工具在容器内执行）。
# 工作区基础镜像（必须含 python3；首次启动会构建带网关 venv 的派生镜像）
LINGSHU_WORKSPACE_BASE_IMAGE=gitciu8080/lingshu-kali:latest
# 容器内 MCP 网关节选端口（留空自动分配）
# LINGSHU_WORKSPACE_GATEWAY_PORT=
# 额外打进派生镜像的 pip 包（逗号分隔，可选）
# LINGSHU_WORKSPACE_DOCKER_EXTRA_PIP=numpy,pandas

# ── 完整 Docker Compose 部署（Linux）──
# API 镜像（默认使用已发布的镜像；需要本地调试时可改为 lingshu-api:local）
LINGSHU_API_IMAGE=gitciu8080/lingshu-api:latest
# API 容器通过 Docker Socket 创建每会话 kali 工作区。下面两个根目录在
# Linux 生产环境必须相同，且均为 Docker host 与 API 容器可见的绝对路径。
# 先创建目录并授权给 API 容器用户（UID/GID 10001）。
# WebUI 对宿主机绑定的端口（默认 8080）。
LINGSHU_APP_PORT=8083
LINGSHU_WORKSPACE_ROOT=/workspace/WorkDir/v2
LINGSHU_WORKSPACE_DOCKER_HOST_ROOT=./WorkDir/v2
# AgentScope /agentscope 入口的独立工作区根目录，应位于上面根目录下。
LINGSHU_AGENT_SERVICE_WORKSPACE_ROOT=/workspace/WorkDir/v2/agent-service
# /agentscope 的 Docker daemon 可见路径；Linux 标准部署下与上一行相同。
LINGSHU_AGENT_SERVICE_DOCKER_HOST_ROOT=./WorkDir/v2/agent-service
# 可固定 Compose 使用的远程 MCP 镜像版本，避免部署时无意升级。
LINGSHU_IDA_MCP_IMAGE=gitciu8080/lingshu-ida-mcp:latest
LINGSHU_ANTSWORD_IMAGE=gitciu8080/lingshu-antsword:latest

# ── 容器化 IDA MCP（宿主直连，默认 127.0.0.1:8745）──
# /upload API 上传二进制并自动分析；MCP 端点为 <URL>/sse
# LINGSHU_IDA_MCP_URL=http://127.0.0.1:8745

# ── AntSword MCP（docker 部署下已容器常驻，host 模式不自动拉起）──
# 默认直连 127.0.0.1:30080/sse（Host 头白名单仅放行 localhost）
# LINGSHU_ANTSWORD_MCP_URL=http://127.0.0.1:30080/sse
